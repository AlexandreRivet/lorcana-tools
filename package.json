{
  "name": "duels-meta-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly collection and visualisation of the Lorcana meta from the public duels.ink API",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "collect": "node scripts/collect.js",
    "collect:tournaments": "node --env-file-if-exists=.env scripts/collect-tournaments.js",
    "digest": "node scripts/digest.js",
    "post:discord": "node --env-file-if-exists=.env scripts/post-discord.js",
    "check:api": "node scripts/check-api.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "podcast:script": "node --env-file-if-exists=.env scripts/podcast-script.js",
    "podcast:audio": "node --env-file-if-exists=.env scripts/podcast-audio.js",
    "costs": "node --env-file-if-exists=.env scripts/costs.js"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@resvg/resvg-js": "^2.6.2",
    "d3": "^7.9.0",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1"
  }
}
